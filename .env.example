# Copy to .env and adjust only when the host or selected local model changes.
# The service port is loopback-only by default. Set SERVICE_BIND_ADDRESS=0.0.0.0
# only for a separately controlled test host.
SERVICE_BIND_ADDRESS=127.0.0.1
SERVICE_PORT=18000
LOG_DIR=./logs

# This small model is for a connection smoke check. Record a frozen model
# selection separately before any benchmark.
OLLAMA_MODEL=qwen3:0.6b
OLLAMA_TIMEOUT_SECONDS=120

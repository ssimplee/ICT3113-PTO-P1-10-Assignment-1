      <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="Capture request ID">
        <stringProp name="RegexExtractor.useHeaders">true</stringProp>
        <stringProp name="RegexExtractor.refname">request_id</stringProp>
        <stringProp name="RegexExtractor.regex">(?im)^X-Request-ID:\s*([^\r\n]+)</stringProp>
